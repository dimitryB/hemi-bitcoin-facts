{
  "name": "@hemi-bitcoin-facts/sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimitryB/hemi-bitcoin-facts.git",
    "directory": "sdk"
  },
  "description": "Check, record and verify Bitcoin facts, PoP finality and fidelity bonds on Hemi from an RPC alone",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "hbf": "./bin/hbf.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "hbf": "node --import tsx src/cli/index.ts",
    "gen:abi": "node --import tsx src/abi/generate.ts",
    "test:regtest": "bash ../regtest/run.sh"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@scure/btc-signer": "1.8.1",
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
